{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./logs/**)",
      "Read(./.deploy/**)",
      "Bash(cat .deploy/*)",
      "Bash(cat ./.deploy/*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(head:*.env*)",
      "Bash(tail:*.env*)",
      "Bash(sed:*.env*)",
      "Bash(grep:*.env*)",
      "Bash(less .env*)"
    ]
  }
}

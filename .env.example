# Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username

# Admin Configuration
# По ID (JSON-массив или через запятую): ["123456789"] или 123456789,987654321
ADMIN_USER_IDS=[]
# По username (без @, регистр не важен): бот узнает ID при первом сообщении от этого человека
# и запомнит его в базе. Username привязывается один раз — чужой, занявший старое имя, прав не получит.
ADMIN_USERNAMES=["your_username"]

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=botdb
POSTGRES_USER=botuser
POSTGRES_PASSWORD=securepassword

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Environment
ENV=development

# Logging
LOG_LEVEL=INFO
# Логи в формате JSON Lines (пусто — только stdout). Агент читает этот файл, чтобы понять, что бот ответил.
LOG_FILE=logs/bot.jsonl

# Примеры хендлеров (/survey, /items) — образцы паттернов. В продакшене выключите.
EXAMPLE_HANDLERS=true

# Часовой пояс для расписаний (IANA)
TIMEZONE=Europe/Moscow

# Проверка живых пользователей: раз в N дней ночью (03:00–05:59 по TIMEZONE) бот проверяет,
# кто заблокировал его или удалил аккаунт, и исключает их из рассылок. 0 — только вручную из /admin.
LIVENESS_CHECK_INTERVAL_DAYS=7
# Запросов в секунду во время проверки (лимит Telegram ~30/с, остальное — живому трафику)
LIVENESS_RATE_LIMIT_RPS=15

# ========================================
# Local Bot API Settings (Optional)
# ========================================
# Для загрузки файлов до 2GB вместо 50MB
# Получить на https://my.telegram.org

USE_LOCAL_API=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
LOCAL_API_HOST=telegram-bot-api
LOCAL_API_PORT=8081
